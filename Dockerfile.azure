FROM python:3.12-slim

# 1. Instalar dependencias del sistema y certificados
RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    ca-certificates \
    libasound2 \
    wget \
    curl \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. ESTA ES LA SOLUCIÓN AL ERROR 2176
# Definimos explícitamente dónde están los certificados para que el SDK de C++ los encuentre
ENV SSL_CERT_DIR=/etc/ssl/certs
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

WORKDIR /app

# Copiar requirements e instalar
COPY requirements.txt .
# Aseguramos upgrade de pip por si acaso
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copiar código y modelos
COPY . .

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]